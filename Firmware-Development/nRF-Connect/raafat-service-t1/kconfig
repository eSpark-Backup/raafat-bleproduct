source "Kconfig.zephyr"

menu "Raafat Analog Service"

config BT_RAAFAT_LOG_LEVEL

	int "Raafat Log level"
	default 4
	help
	  set log level for raafat's logs

config BT_RAAFAT_POLL_ANALOG
	bool "Enable Poll Analog"
	default y
	help
	  Allows user to fetch data from BLE Device


config BT_RAAFAT_SECURITY_ENABLED
	bool "Enable Security for BLE Service"
	default y
	help
	  Enable security for better pairing and authentication

config BT_RAAFAT_ENABLE_GYRO_PACKET
	bool "Enable gyroscope data packet in BLE"
	default y
	help
	  Enable the packet to be available in JSON

config BT_RAAFAT_ENABLE_ACCEL_PACKET
	bool "Enable Accelerometer data packet in BLE"
	default y
	help
		Enable the packet to be available in JSON

config BT_RAAFAT_ENABLE_MAGN_PACKET
	bool "Enable Mangetometer data packet in BLE"
	default y
	help
		Enable the packet to be available in JSON

config BT_RAAFAT_ENABLE_NOTIFY
	bool "Enable auto Notifification"
	default y
	help
	  Enables notification in a given interval

config RAAFAT_SERVICE_UPDATE_INTERVAL_SEC
	int "Time duration in seconds"
	default 1
	help
	  Defines Notfication interval in seconds
endmenu